{
  "buildCommand": "npm run build --workspace=@nairacloud/admin",
  "outputDirectory": ".next",
  "installCommand": "npm install",
  "framework": "nextjs",
  "rewrites": [],
  "redirects": [],
  "headers": [
    {
      "source": "/:path*",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ],
  "env": {
    "NEXT_PUBLIC_API_URL": "https://api.nairacloud.xyz",
    "NEXT_PUBLIC_WS_URL": "https://api.nairacloud.xyz",
    "NEXT_PUBLIC_ADMIN_URL": "https://admin.nairacloud.xyz"
  }
}
