              </div>
              <div className="space-y-2 max-h-[50vh] overflow-y-auto scrollbar-none">
                {probeProgress.map((step, idx) => (
                  <div key={idx} className="flex items-start gap-3 p-3 rounded-lg bg-surface/50 border border-border/30 animate-slide-in">
                    <div className="flex-shrink-0 w-8 h-8 flex items-center justify-center rounded-full bg-accent/10 text-accent text-sm">
                      {probeStepIcon(step.step)}
                    </div>
