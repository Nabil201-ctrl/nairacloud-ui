            <div className="rounded-xl border border-border/40 bg-surface/95 p-4 shadow-2xl max-h-[60vh] overflow-hidden animate-slide-up">
              <div className="flex items-center justify-between mb-3">
                <div className="flex items-center gap-2">
                  <span className="text-accent text-xl">🔍</span>
                  <span className="font-semibold text-text">Live Probe Progress</span>
                  <span className="text-xs text-text-muted/60 font-mono">Real-time</span>
                </div>
                <button
                  onClick={() => setProbeProgress([])}
                  className="press rounded-md p-1.5 text-text-muted hover:bg-surface-hover hover:text-text"
