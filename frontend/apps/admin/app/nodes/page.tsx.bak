"use client";

import Link from "next/link";
import { useEffect, useState } from "react";
import { toast } from "sonner";
import { TerminalWindow, SquaresFour } from "@phosphor-icons/react";
import { PageHead, Pill, Meter } from "@/components/ui";
import { Modal } from "@/components/modal";
import { NodeTerminal, CommandLogEntry } from "@/components/node-terminal";
import { OnboardModal } from "./onboard-modal";
import { api } from "@/lib/api";
import { useRealtime, ProbeProgressData } from "@/hooks/use-realtime";

type HeartbeatMeta = {
  cpuPct?: number;
  ramUsedMb?: number;
  diskUsedGb?: number;
  instanceCount?: number;
};

type Node = {
  id: string;
  name: string;
  status: string;
  region: string;
  hostname?: string | null;
  agentVersion?: string | null;
  totalCpu: number;
  totalRamMb: number;
  totalStorageGb: number;
  allocatedCpu: number;
  allocatedRamMb: number;
  allocatedStorageGb: number;
  lastHeartbeatAt?: string | null;
  lastHeartbeatMeta?: HeartbeatMeta | null;
  sellPlan?: { mode?: string; plan?: string; slices?: number; cpuPerSlice?: number; ramMbPerSlice?: number; storageGbPerSlice?: number } | null;
  commandLog?: CommandLogEntry[] | null;
  _count?: { instances?: number };
};

const RESTART_BODY =
  "Restarts the node agent (not the host). Disconnects in-flight console sessions for a few seconds. Use when a node stops reporting metrics.";

function pctOrNull(used: number | undefined, total: number | undefined): number | null {
  if (used == null || total == null || total <= 0) return null;
  return Math.round((used / total) * 100);
}

function nodeMeters(n: Node) {
  const meta = n.lastHeartbeatMeta ?? {};
  return {
    cpu: meta.cpuPct != null ? Math.round(meta.cpuPct) : pctOrNull(n.allocatedCpu, n.totalCpu),
    ram: meta.ramUsedMb != null ? pctOrNull(meta.ramUsedMb, n.totalRamMb) : pctOrNull(n.allocatedRamMb, n.totalRamMb),
    disk: meta.diskUsedGb != null ? pctOrNull(meta.diskUsedGb, n.totalStorageGb) : pctOrNull(n.allocatedStorageGb, n.totalStorageGb),
    instances: meta.instanceCount ?? n._count?.instances,
    heartbeat: n.lastHeartbeatAt
      ? new Date(n.lastHeartbeatAt).toLocaleString("en-NG", { month: "short", day: "numeric", hour: "2-digit", minute: "2-digit" })
      : "—",
  };
}

function probeStepLabel(step: string): string {
  switch (step) {
    case "connecting": return "Connecting via SSH...";
    case "connected": return "SSH connected";
    case "exec": return "Executing command...";
    case "output": return "Command output received";
    case "docker-detected": return "Docker detected";
    case "docker-ps": return "Listing Docker containers";
    case "docker-ps-done": return "Docker containers listed";
    case "complete": return "Probe complete";
    default: return step;
  }
}

function probeStepIcon(step: string) {
  switch (step) {
    case "connecting": return "🔌";
    case "connected": return "✅";
    case "exec": return "⚡";
    case "output": return "📄";
    case "docker-detected": return "🐳";
    case "docker-ps": return "📋";
    case "docker-ps-done": return "✅";
    case "complete": return "🎉";
    default: return "⏳";
  }
}

function probeStepColor(step: string) {
  switch (step) {
    case "complete": return "text-green-500";
    case "exec": return "text-amber-500";
    case "output": return "text-blue-500";
    default: return "text-text-muted";
  }
}

function probeStepTime(timestamp: string) {
  return new Date(timestamp).toLocaleTimeString("en-NG", { hour: "2-digit", minute: "2-digit", second: "2-digit" });
}

