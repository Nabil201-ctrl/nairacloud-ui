  const { isConnected, probeProgress: realtimeProbeProgress, clearProbeProgress } = useRealtime();

  useEffect(() => {
    if (realtimeProbeProgress.length > 0) {
      setProbeProgress(realtimeProbeProgress);
    }
  }, [realtimeProbeProgress]);

  const handleProbe = async (ip: string, sshUser: string, sshPassword?: string, sshPrivateKey?: string) => {
    setProbeProgress([]);
    try {
      const res = await api().post("/v1/admin/nodes/probe", { ip, sshUser, sshPassword, sshPrivateKey });
      toast.success("Probe completed");
      return res.data;
    } catch (err: any) {
      toast.error(err.response?.data?.error?.message || "Probe failed");
      throw err;
    }
  };

  const handleOnboard = async (dto: any) => {
    try {
      await api().post("/v1/admin/nodes/onboard", dto);
      toast.success("Onboard queued");
      setOnboardOpen(false);
      refetch();
    } catch (err: any) {
      toast.error(err.response?.data?.error?.message || "Onboard failed");
    }
  };

  const refetch = async () => {
    setPending(true);
    try {
      const data = await api().get("/v1/admin/nodes");
      setNodes(data as Node[]);
    } catch (err) {
      toast.error("Failed to load nodes");
    } finally {
      setPending(false);
    }
  };

  useEffect(() => {
